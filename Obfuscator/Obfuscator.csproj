<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Squalor.Obfuscator</PackageId>
        <Title>Squalor Obfuscator</Title>
        <Description>CSV generation, reversible obfuscation, and deobfuscation utilities for .NET.</Description>
        <PackageTags>csv;obfuscation;privacy;dotnet;data</PackageTags>
        <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CsvHelper" Version="33.1.0" />
    </ItemGroup>

    <ItemGroup>
      <None Include="PackageReadme.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
      <InternalsVisibleTo Include="Obfuscator.Tests" />
    </ItemGroup>

</Project>
